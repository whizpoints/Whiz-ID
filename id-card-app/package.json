{
  "name": "id-card-app",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "author": "Enterprise Studio",
  "description": "ID Card Production Desktop App",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "dev": "concurrently -k \"npm run dev:vite\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build": "tsc -b && vite build && npm run build:electron",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.enterprise.idcardstudio",
    "productName": "ID Card Studio",
    "directories": {
      "output": "dist-app"
    },
    "win": {
      "target": "nsis",
      "icon": "public/favicon.svg"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/favicon.svg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/favicon.svg"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ]
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.4",
    "jspdf": "^4.2.1",
    "konva": "^10.7.0",
    "lucide-react": "^1.48.0",
    "postcss": "^8.5.28",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-konva": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
